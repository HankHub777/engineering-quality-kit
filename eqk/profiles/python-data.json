{
  "id": "python-data",
  "version": "0.1.0",
  "extends": "minimal",
  "description": "Python data / script projects: minimal + formatting and type checks as non-blocking signals.",
  "checks": [
    {"id": "py.format", "tool": "ruff", "args": ["format", "--check", "."], "applies_to": "python", "gate": false,
     "install_hint": "pip install ruff",
     "note": "Non-gate on purpose: eqk never reformats an existing codebase."},
    {"id": "py.types", "tool": "mypy", "args": ["."], "applies_to": "python", "gate": false,
     "install_hint": "pip install mypy"}
  ],
  "scaffold": [
    {"path": "ruff.toml", "template": "ruff.toml", "applies_to": "python", "skip_if": "ruff_config"}
  ]
}
